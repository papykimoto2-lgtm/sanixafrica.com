# Projet Supabase SNIFI (Settings → API). La clé publique est conçue pour être exposée au navigateur :
# la sécurité repose sur Supabase Auth et sur les contrôles des fonctions de l'API.
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé publique (anon / publishable)>
